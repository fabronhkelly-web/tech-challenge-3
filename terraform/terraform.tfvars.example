# Copy to terraform.tfvars and adjust as needed:
#   cp terraform.tfvars.example terraform.tfvars
# All values below are optional; the defaults work as-is.

aws_region    = "us-east-1"
project_name  = "tech-challenge-3"
environment   = "dev"
instance_type = "t3.micro"

# Leave empty to auto-detect your current public IP, or pin it explicitly:
# ssh_allowed_cidr = "203.0.113.10/32"
ssh_allowed_cidr = ""
