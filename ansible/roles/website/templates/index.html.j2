<!doctype html>
<!-- {{ ansible_managed }} -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ website_title }}</title>
  <style>
    :root { color-scheme: light dark; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
    }
    main { text-align: center; padding: 2rem; }
    h1 { font-size: clamp(2.5rem, 8vw, 5rem); margin: 0 0 1rem; }
    p { margin: .25rem 0; color: #94a3b8; }
    code { color: #fbbf24; }
  </style>
</head>
<body>
  <main>
    <h1>Hello, World!</h1>
    <p>{{ website_message }}</p>
    <p>Served by Nginx on <code>{{ ansible_facts['hostname'] }}</code> ({{ website_environment }})</p>
  </main>
</body>
</html>
